# Settings for the production stack (docker-compose.yml). Copy this file to
# .docker/.env on the server; Docker Compose reads it from there. The API's
# own settings (JWT secrets, rate limits) are in the repo root's .env.

# Domain pointing at the server, and the email Let's Encrypt sends expiry
# notices to (see `make dockerCertificate`)
DOMAIN=library.example.com
CERTBOT_EMAIL=admin@example.com

# Used when the database volume is first created, and to build the API's
# DATABASE_URL. Keep the password URL-safe: openssl rand -hex 32
POSTGRES_USER=library
POSTGRES_PASSWORD=
POSTGRES_DB=library

# pgAdmin's login, at https://<DOMAIN>/pgadmin4/
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Grafana's admin password, at https://<DOMAIN>/grafana/ (user admin). Read
# when its volume is first created: openssl rand -hex 16
GRAFANA_PASSWORD=

# The deploy hook's token (make serverHook), also the GitHub secret
# DEPLOY_TOKEN: openssl rand -hex 32
DEPLOY_TOKEN=
