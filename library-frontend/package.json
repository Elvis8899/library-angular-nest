{
  "name": "library-frontend",
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:serve": "npx http-server -p 8080 -c-1 dist/library-frontend/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format-staged": "pretty-quick --staged",
    "write:env": "ngx-scripts env npm_package_version",
    "prettier": "prettier --write \"./src/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./src/**/*.{ts,js,html,scss}\"",
    "style:format": "prettier -w ./src --ignore-unknown",
    "postinstall": "npm run prettier -s",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@ngneat/overview": "8.1.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@ngxpert/hot-toast": "6.1.0",
    "bootstrap": "5.3.8",
    "rxjs": "^7.8.2",
    "sanitize.css": "^13.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@angular/localize": "22.2.2",
    "@eslint/js": "^9.30.0",
    "@ngneat/spectator": "^22.1.0",
    "@ngx-rocket/scripts": "^5.2.3",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "4.2.2",
    "reflect-metadata": "^0.2.1",
    "stylelint": "~17.0.0",
    "stylelint-config-recommended-scss": "~17.0.0",
    "stylelint-config-standard": "~40.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.18"
  }
}
