// One per login. Refresh tokens are single-use: only the token carrying the
// session's current jti is accepted, and each refresh replaces it
model RefreshSession {
  id         String   @id
  currentJti String
  expiresAt  DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Access tokens aren't stored, so revoking them is a row the auth guard
// reads on every request: the user's tokens carrying a lower version are
// refused. One row per user, the latest revocation; once expiresAt passes,
// every token it refuses has expired by itself, and revoking purges it
model TokenRevocation {
  userId       String   @id
  tokenVersion Int
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
