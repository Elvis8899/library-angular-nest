{
  "version": "1.0.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest: current file",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.test",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--no-file-parallelism"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
