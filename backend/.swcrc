{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "module": { "type": "commonjs" },
  "jsc": {
    "target": "es2024",
    "parser": { "syntax": "typescript", "decorators": true },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "keepClassNames": true,
    "baseUrl": "./",
    "paths": {
      "@src/*": ["./src/*"],
      "@shared/*": ["./src/modules/shared/*"],
      "@modules/*": ["./src/modules/*"],
      "@db/*": ["./prisma/*"]
    }
  }
}
