{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Biblioteca",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ \"{src,apps,libs,test,prisma,scripts}/**/*.ts\" --fix",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/eslint/ \"{src,apps,libs,test,prisma,scripts}/**/*.ts\"",
    "lint:changed": "sh -c 'files=$({ git diff --name-only --relative --diff-filter=d HEAD -- \"*.ts\"; git ls-files --others --exclude-standard -- \"*.ts\"; } | sort -u); if [ -n \"$files\" ]; then eslint --cache --cache-location node_modules/.cache/eslint/ $files; else echo No changed files.; fi'",
    "typecheck": "tsc --noEmit",
    "test:watch": "env-cmd -f .env.test --no-override vitest",
    "test:debug": "env-cmd -f .env.test --no-override vitest --inspect-brk --no-file-parallelism",
    "test:cov": "env-cmd -f .env.test --no-override vitest run --coverage",
    "test:e2e": "env-cmd -f .env.test --no-override vitest run --project database --coverage --coverage.include='src/**/*controller.ts' .e2e-spec.ts",
    "test:inte": "env-cmd -f .env.test --no-override vitest run --project database --coverage --coverage.include='src/**/database/real*.ts' .inte-spec.ts",
    "test:unit": "env-cmd -f .env.test --no-override vitest run --project unit --coverage --coverage.include='src/**/commands/**/*.command.ts' --coverage.include='src/**/domain/**/*.ts' --coverage.include='src/**/queries/**/*.query.ts'",
    "test:module": "sh -c 'reports=$(mktemp -d); env-cmd -f .env.test --no-override vitest run test/modules/${1:?usage: yarn test:module <module>} --coverage --coverage.include=\"src/modules/$1/**\" --coverage.reportsDirectory=\"$reports\"; status=$?; rm -rf \"$reports\"; exit $status' --",
    "test:docker:up": "docker compose -f ../.docker/docker-compose-dev.yml up postgres -d && sleep 5 && env-cmd -f .env.test --no-override yarn migrate:reset --force && env-cmd -f .env.test --no-override yarn seed",
    "test:migrate": "env-cmd -f .env.test --no-override yarn migrate:deploy",
    "migrate:check": "env-cmd -f .env.test --no-override prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "migrate": "prisma migrate dev",
    "migrate:init": "prisma migrate dev --name init",
    "migrate:reset": "prisma migrate reset",
    "migrate:deploy": "prisma migrate deploy",
    "scaffold": "ts-node -r tsconfig-paths/register --transpile-only scripts/scaffold/cli.ts",
    "seed": "prisma db seed",
    "docker:dev": "docker compose --file ../.docker/docker-compose-dev.yml up --build -d",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/request-context": "^7.0.5",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "env-var": "^7.5.0",
    "fp-ts": "^2.16.11",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "env-cmd": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prettier": "^5.5.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
