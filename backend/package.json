{
  "name": "backend",
  "version": "0.0.1",
  "description": "Biblioteca",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\"",
    "test:watch": "env-cmd -f .env.test jest --config ./test/jest.config.ts --watch --runInBand",
    "test:debug": "env-cmd -f .env.test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:cov": "env-cmd -f .env.test jest --config ./test/jest-cov.config.ts --coverage",
    "test:e2e": "env-cmd -f .env.test jest --config ./test/jest-e2e.config.ts",
    "test:inte": "env-cmd -f .env.test jest --config ./test/jest-integration.config.ts",
    "test:unit": "env-cmd -f .env.test jest --config ./test/jest-unit.config.ts",
    "test:docker:up": "docker compose -f ../.docker/docker-compose-dev.yml up postgres -d && sleep 5 && env-cmd -f .env.test yarn migrate:reset --force && env-cmd -f .env.test yarn seed",
    "test:migrate": "env-cmd -f .env.test yarn migrate:deploy",
    "migrate:check": "env-cmd -f .env.test prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "migrate": "prisma migrate dev",
    "migrate:init": "prisma migrate dev --name init",
    "migrate:reset": "prisma migrate reset",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "docker:dev": "docker compose --file ../.docker/docker-compose-dev.yml up --build -d",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/request-context": "^7.0.5",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "env-var": "^7.5.0",
    "fp-ts": "^2.16.11",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "env-cmd": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
