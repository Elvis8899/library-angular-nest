LOG_PRETTIFY='true'
LOG_LEVEL='info'

# ----------------------------------------------------------
# Server configuration
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Prometheus scrapes the API's metrics here (GET /metrics); nginx never
# proxies it, so it needs no token
METRICS_PORT=9464

# ----------------------------------------------------------
# Prisma configuration
# ----------------------------------------------------------
DATABASE_URL='postgresql://user:password@postgres:5432/library'
# DATABASE_URL='postgresql://user:password@localhost:5432/library' #for local

# ----------------------------------------------------------
# Auth configuration
# ----------------------------------------------------------
# Required, at least 32 characters. The values below are for local development only.
# Generate real ones with: openssl rand -base64 48
JWT_SECRET_KEY='dev-only-insecure-jwt-secret-change-me-in-production'
JWT_REFRESH_SECRET='dev-only-insecure-jwt-refresh-secret-change-me-in-production'

# ----------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------
# Login attempts allowed per client IP and email within the window
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Proxies allowed to set X-Forwarded-For: unset/false (default), true, or a
# comma-separated list of IPs/CIDRs. Behind the production nginx, which
# reaches the app through the Docker gateway, use e.g. 172.18.0.0/16.
# TRUST_PROXY=172.18.0.0/16

# ----------------------------------------------------------
# File storage (S3-compatible: the books' covers)
# ----------------------------------------------------------
# Leave S3_ENDPOINT unset for AWS S3; S3_FORCE_PATH_STYLE=true for
# self-hosted servers (SeaweedFS in the compose files). The API creates the
# bucket when it's missing.
S3_ENDPOINT='http://storage:8333'
S3_REGION='us-east-1'
S3_BUCKET='library'
S3_ACCESS_KEY_ID='storage'
S3_SECRET_ACCESS_KEY='storage-password'
S3_FORCE_PATH_STYLE='true'
